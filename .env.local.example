# ============================================================
#  環境変数サンプル
#  このファイルを .env.local という名前でコピーし、値を埋めてください。
#  .env.local は Git にコミットされません（.gitignore 済み）。
# ============================================================

# --- Supabase（必須） ---
# Supabase ダッシュボード > Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 音声メモ機能（任意 / 使う場合は必須） ---
# Groq: 音声→テキスト変換（Whisper）  https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# --- プッシュ通知（任意 / 使う場合は5つとも必須） ---
# 短期メモがゴミ箱へ移動する2日前の朝9時に、まとめて1通お知らせする機能。
# 未設定でもアプリは動きます（設定画面の通知トグルが失敗するだけ）。

# VAPID 鍵。`npx web-push generate-vapid-keys` で生成し、公開鍵/秘密鍵を貼る。
# 公開鍵はブラウザに渡すため NEXT_PUBLIC_ 付き。秘密鍵は絶対に付けないこと。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# プッシュサービスが要求する連絡先。自分のメールアドレスを mailto: 形式で。
VAPID_SUBJECT=mailto:you@example.com

# 【取扱注意】Supabase の service_role キー。RLS を完全に迂回して全ユーザーの
# データを読めるため、絶対に NEXT_PUBLIC_ を付けない（ブラウザに出さない）。
# 配信バッチが全ユーザーのメモを横断して期限を調べるためだけに使う。
# Supabase ダッシュボード > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 配信バッチ(/api/cron/expiry-notify)を外部から叩かれないようにする合言葉。
# 適当な長いランダム文字列でよい（例: `openssl rand -base64 32`）。
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
