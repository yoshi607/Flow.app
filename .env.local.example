# ============================================================
#  環境変数サンプル
#  このファイルを .env.local という名前でコピーし、値を埋めてください。
#  .env.local は Git にコミットされません（.gitignore 済み）。
# ============================================================

# --- Supabase（必須） ---
# Supabase ダッシュボード > Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 音声メモ機能（任意 / 使う場合は必須） ---
# Groq: 音声→テキスト変換（Whisper）  https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
